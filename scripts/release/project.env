# IKEA delivery identifiers (release zip name + config.json).
#
# Zip name: {IKEA_PROJECT_ID}-{M.m.p}-unsigned.zip
# Example:  4476-36900-1.1.0-unsigned.zip
#
# IKEA_PROJECT_ID decimal pair = VID-PID (4476 = 0x117C, 36900 = 0x9024 KAJEN floor).
IKEA_PROJECT_ID="4476-36900"

# Matter productId in config.json (hex). KAJEN floor lamp = 0x9024.
IKEA_PRODUCT_ID="0x9024"

# OTA window baseline: minimum device version allowed to receive packages.
IKEA_OTA_MIN_VERSION="0x01010000"

# Optional override for maxVersion (hex). Leave empty to auto-set to (version - 1 build).
IKEA_OTA_MAX_VERSION=""

# --- Matter .ota creation (Simplicity Commander) ---
# Test defaults match CHIPProjectConfig.h (0xFFF1/0x8005). Switch to 0x117C/0x9024
# when firmware VID/PID is updated for production.
OTA_VENDOR_ID="0xFFF1"
OTA_PRODUCT_ID="0x8005"

# MG301 / SixG301 uses gbl4; MG24 projects should set OTA_GBL_CMD=gbl
OTA_GBL_CMD="gbl4"
OTA_COMPRESS="lzma"

# Optional: pass --device to commander (reduces "unknown memory layout" warning).
OTA_DEVICE="SIMG301M113WIH"
