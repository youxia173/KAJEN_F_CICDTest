# SLT recipe: CI firmware build (compile only, no slc/zap/java).
# Recipe files must use the .slt extension (see Silicon Labs SLT docs).
version = "0"

[dependency]
simplicity-sdk = "2025.12.1"
matter_extension = "~"
cmake = "3.30.2"
ninja = "1.12.1"
commander = "1.23.1"
gcc-arm-none-eabi = "12.2.rel1"
